# Local defaults are intentionally loopback-friendly and evidence-only.
CAPSTONE_AUTH_ENABLED=false
# Set this only when CAPSTONE_AUTH_ENABLED=true. Inject it from a secret manager
# in a deployment; never commit a value here or in a container image.
CAPSTONE_AUTH_TOKEN=
CAPSTONE_RATE_LIMIT_ENABLED=true
CAPSTONE_RATE_LIMIT_REQUESTS=60
CAPSTONE_RATE_LIMIT_WINDOW_SECONDS=60
# Leave false unless a trusted reverse proxy is configured and documented.
CAPSTONE_TRUST_PROXY_HEADERS=false
# Comma-separated exact proxy IP/CIDR allowlist. Required when forwarding is enabled.
CAPSTONE_TRUSTED_PROXY_CIDRS=

# Optional OpenAI-compatible generation. Leave these blank for evidence-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Exact comma-separated HTTPS host allowlist for OPENAI_BASE_URL.
CAPSTONE_PROVIDER_ALLOWED_HOSTS=api.openai.com

# Optional when running the installed package outside this source checkout.
# Docker and Compose set these paths explicitly.
# CAPSTONE_CORPUS_DIR=data/documents
# CAPSTONE_CORPUS_MANIFEST_PATH=data/corpus_manifest.json
# CAPSTONE_STATIC_DIR=app/static
# Non-secret integrity/version pins. Keep these paired with the reviewed image.
# CAPSTONE_CORPUS_VERSION=corpus-v1
# CAPSTONE_CORPUS_MANIFEST_SHA256=<reviewed-corpus-manifest-sha256>
# CAPSTONE_INDEX_VERSION=tfidf-markdown-v1
